{
  "name": "react-notes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@react-notes/frontend",
    "build": "npm run build --workspace=@react-notes/frontend",
    "lint": "npm run lint --workspace=@react-notes/frontend",
    "preview": "npm run preview --workspace=@react-notes/frontend",
    "dev:frontend": "npm run dev --workspace=@react-notes/frontend",
    "build:frontend": "npm run build --workspace=@react-notes/frontend",
    "dev:backend": "npm run dev --workspace=@react-notes/backend",
    "build:backend": "npm run build --workspace=@react-notes/backend",
    "build:all": "npm run build --workspaces",
    "lint:all": "npm run lint --workspaces"
  },
  "devDependencies": {
    "npm": "^10.0.0"
  }
}
